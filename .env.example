# ---- Server -------------------------------------------------------------
PORT=3000
NODE_ENV=development            # set to "production" when live (enables Secure cookies + HSTS)
APP_URL=http://localhost:3000   # public URL, used in email links (e.g. https://invest.yourdomain.com)
TRUST_PROXY=0                   # set to 1 when running behind Nginx/Cloudflare/a load balancer

# ---- Database -----------------------------------------------------------
# Leave empty to use the built-in SQLite file at ./data/estateinvest.db
# PostgreSQL is required on Vercel; SQLite is local-development only.
# DATABASE_URL=postgres://user:password@host:5432/estateinvest

PGSSL=0                         # 1 for managed Postgres that requires SSL
SQLITE_PATH=
UPLOAD_DIR=                     # defaults to ./data/uploads (keep OUTSIDE the public folder)

# ---- Sessions -----------------------------------------------------------
SESSION_DAYS=7

# ---- First admin (created only on an empty database) --------------------
SEED_ADMIN_EMAIL=admin@estateinvest.com
SEED_ADMIN_PASSWORD=Admin@12345  # CHANGE THIS before first production start
SEED_DEMO_DATA=1                 # 0 = start with no demo properties/investors

# ---- Email (Resend: https://resend.com) ---------------------------------
# Without a key, emails are saved to the admin "Email log" and printed to the console.
RESEND_API_KEY=
MAIL_FROM=Manulife Financial Investment <no-reply@yourdomain.com>

# ---- Translation of content you add later (optional) --------------------
# Everything built into the website and investor dashboard is already translated
# (French, Spanish, Portuguese, German). These keys only matter for text an admin
# adds afterwards, such as a new property description or news article.
# DeepL (recommended, the free plan is enough): https://www.deepl.com/pro-api
DEEPL_API_KEY=
# Or a LibreTranslate server instead of DeepL:
LIBRETRANSLATE_URL=
LIBRETRANSLATE_API_KEY=

# ---- Vercel persistent uploads and scheduled jobs -----------------------
# Connect a private Vercel Blob store. Local migration uses its read/write token.
BLOB_READ_WRITE_TOKEN=
# Configure an external scheduler to call /api/cron/tick with this Bearer token.
CRON_SECRET=

# ---- Crypto payment provider webhook ------------------------------------
# Shared secret for POST /api/webhooks/payments (HMAC-SHA256 of the raw body in X-Signature)
PAYMENT_WEBHOOK_SECRET=
